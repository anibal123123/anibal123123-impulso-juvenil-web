# Copia este archivo a .env.local y sustituye los valores en tu equipo.
# En Vercel: Project > Settings > Environment Variables (Production / Preview).
# Nunca copies claves reales dentro del repositorio ni del ZIP que compartas.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require
BETTER_AUTH_SECRET=GENERA_UN_SECRETO_ALEATORIO_LARGO
BETTER_AUTH_URL=http://localhost:3000

# Primero regístrate y obtén tu ID desde SELECT id,email FROM "user";
# Después añade el ID y reinicia / publica la nueva configuración.
ADMIN_USER_IDS=

# OPCIONAL: si usas Resend con dominio remitente verificado,
# se habilitan verificación de correo obligatoria y recuperación de contraseña.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Impulso Juvenil <cuentas@tudominio.cl>
